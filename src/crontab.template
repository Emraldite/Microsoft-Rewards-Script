# Set PATH so cron jobs can find node/npm
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Set timezone for cron jobs
TZ=${TZ}

# Run automation according to CRON_SCHEDULE; redirect both stdout & stderr to Docker logs
${CRON_SCHEDULE} /usr/src/microsoft-rewards-script/scripts/docker/run_daily.sh >> /proc/1/fd/1 2>&1

# Check only for a claimable bonus banner every hour; skip searches and all other tasks
${BONUS_CRON_SCHEDULE} SKIP_RANDOM_SLEEP=true RUN_ARGS='-claimBonusPointsOnly' /usr/src/microsoft-rewards-script/scripts/docker/run_daily.sh >> /proc/1/fd/1 2>&1
